MASTER_BOT_TOKEN=
# Backward-compatible alias: MASTER_TOKEN=
MONGO_URI=
DB_NAME=telegram_multibot
WEBHOOK_BASE_URL=https://your-public-domain.example
MASTER_WEBHOOK_PATH=/telegram/webhook/master
WEBHOOK_SECRET=
# WEBHOOK_BASE_URL falls back to RENDER_EXTERNAL_URL on Render if omitted.
PORT=10000
ENVIRONMENT=production
MODE=webhook
ADMIN_IDS=
# Backward-compatible alias: SUPER_ADMINS=
BOT_TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=INFO
DROP_PENDING_UPDATES=false
TELEGRAM_MAX_CONNECTIONS=20
# VPS: local Telegram Bot API server. API URL is separate from the public webhook URL.
TELEGRAM_API_BASE_URL=http://127.0.0.1:8081
TELEGRAM_API_LOCAL_MODE=true
TELEGRAM_API_TIMEOUT_SECONDS=7200
# Set SERVER root to the path returned by local Bot API getFile, and HOST root to the same files visible to this app.
TELEGRAM_API_SERVER_FILES_ROOT=/root/tg-bot-api/data
TELEGRAM_API_HOST_FILES_ROOT=/root/tg-bot-api/data
# Private channel where each child bot posts one thumbnail-customized copy before fan-out.
CANAL_STORAGE_ID=
VIDEO_RAMDISK_PATH=/mnt/ramdisk
VIDEO_REQUIRE_TMPFS=true
VIDEO_THUMBNAIL_PATH=assets/thumb.jpg
VIDEO_DELIVERY_DELAY_SECONDS=0.04
VIDEO_MAX_UPLOAD_BYTES=2000000000
VIDEO_RAMDISK_RESERVE_BYTES=536870912
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=1
HEALTH_PATH=/health
READY_PATH=/ready
METRICS_PATH=/metrics
HEARTBEAT_INTERVAL_SECONDS=30
SUPERVISOR_INTERVAL_SECONDS=15
HEARTBEAT_GRACE_MULTIPLIER=4
MAX_RESTARTS_PER_WINDOW=8
RESTART_WINDOW_SECONDS=300
MAX_RESTART_DELAY_SECONDS=60
ROOM_QUEUE_MAXSIZE=1000
BROADCAST_WORKERS_PER_BOT=2
BROADCAST_CONCURRENCY_PER_BOT=4
BROADCAST_MAX_RETRIES=3
ALBUM_DEBOUNCE_MS=900
ADMIN_FEED_ENABLED_BY_DEFAULT=true
ADMIN_FEED_MAX_CAPTION_LENGTH=900
CHILD_WEBHOOK_SECRET_LENGTH=32
ALLOW_HTTP_LOCALHOST=false

# Telegram user ID allowed to change global Master settings
SUPER_ADMIN_ID=123456789

MASTER_BOT_TOKEN=123456789:CHANGE_ME
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=telegram_multibot

WEBHOOK_BASE_URL=https://your-service.onrender.com
MASTER_WEBHOOK_PATH=/telegram/webhook/master
WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_BASE_URL=https://your-service.onrender.com

PORT=10000
ENVIRONMENT=production
MODE=webhook
LOG_LEVEL=INFO
SERVICE_NAME=telegram-multibot-platform
DROP_PENDING_UPDATES=false
TELEGRAM_MAX_CONNECTIONS=20

MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=1

HEALTH_PATH=/health
READY_PATH=/ready
METRICS_PATH=/metrics
ENABLE_METRICS=true

ADMIN_IDS=123456789
BOT_TOKEN_ENCRYPTION_KEY=GENERATE_WITH_FERNET
CHILD_WEBHOOK_SECRET_LENGTH=32

REDIS_URI=
BROADCAST_WORKERS_PER_BOT=4
BROADCAST_MAX_CONCURRENCY=8
ROOM_QUEUE_MAXSIZE=1000
ALBUM_DEBOUNCE_MS=750
MAX_MEDIA_PER_USER_PER_MINUTE=20
MAX_ALBUMS_PER_USER_PER_MINUTE=5
MAX_RESTARTS_PER_WINDOW=10
RESTART_WINDOW_SECONDS=300
MAX_RESTART_DELAY_SECONDS=60
HEARTBEAT_INTERVAL_SECONDS=30
WEBAPP_AUTH_MAX_AGE_SECONDS=86400
